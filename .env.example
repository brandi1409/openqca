# openQCA — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach apps/web/.env.local und trage echte Werte ein.
# OHNE diese Werte läuft die App vollständig als kostenloser, local-first Kern —
# Cloud/KI/Zahlungen sind dann sauber deaktiviert.

# ─── App ────────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL (für Stripe-Redirects). Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Docker/Next build arguments: NEXT_PUBLIC_SITE_URL sowie die benötigten
# NEXT_PUBLIC_SUPABASE_* / NEXT_PUBLIC_STRIPE_* Werte müssen beim Image-Build
# mit --build-arg gesetzt werden; Runtime-Werte ändern Browser-Bundles nicht.

# ─── Supabase (P3: Konto, Datenbank, Projekt-Speicherung) ───────────────────
# Aus dem Supabase-Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN_SUPABASE_ANON_KEY
# Service-Role-Key: NUR serverseitig (Stripe-Webhook aktualisiert damit den Tarif). Geheim halten!
SUPABASE_SERVICE_ROLE_KEY=DEIN_SUPABASE_SERVICE_ROLE_KEY

# ─── KI-Assistenten (serverseitig, optional) ────────────────────────────────
# Unterstützte, strikt strukturierte Provider: openai oder gemini.
# Schlüssel niemals als NEXT_PUBLIC_* setzen. AI_ENABLED=false deaktiviert KI
# unabhängig von eventuell gesetzten Zugangsdaten.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_AI_MODEL=
GEMINI_API_KEY=
GEMINI_AI_MODEL=
# Optionale Modell-Overrides. Ohne Override nutzt die App sichere Defaults.
# Standard true: KI-Aufrufe verlangen Anmeldung und Cloud-Tarif.
AI_REQUIRE_CLOUD_TIER=true
# Optionale Schutzgrenzen pro VPS-Prozess.
AI_REQUEST_BODY_BYTES=12000
AI_PREAUTH_RATE_LIMIT=20
AI_USER_RATE_LIMIT=6
AI_MAX_CONCURRENT=2

# ─── VPS / Caddy (nur für deploy/docker-compose.yml) ─────────────────────────
# Beide Images müssen unveränderliche Registry-Digests sein, keine Tags.
# Beispiel: ghcr.io/organisation/openqca-web@sha256:…
OPENQCA_IMAGE=
# Beispiel nach verifiziertem Pull: caddy@sha256:…
CADDY_IMAGE=
OPENQCA_DOMAIN=
CADDY_EMAIL=
# Build provenance; beim Docker-Build zusätzlich als --build-arg OPENQCA_COMMIT setzen.
OPENQCA_COMMIT=
# NEXT_PUBLIC_* Werte werden beim Image-Build fest eingebettet. Gleiche Werte
# hier dokumentieren die Umgebung, können ein gebautes Browser-Bundle aber
# nicht nachträglich verändern.

# ─── Stripe (P5: Abos / Institutions-Lizenz) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_DEIN_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_DEIN_STRIPE_PUBLISHABLE
# Preis-IDs aus dem Stripe-Dashboard (Produkte → Preise anlegen):
STRIPE_PRICE_MONTHLY=price_MONATLICH_ID
STRIPE_PRICE_INSTITUTION=price_INSTITUTION_ID
