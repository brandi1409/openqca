{
  "name": "openqca",
  "private": true,
  "version": "0.2.0",
  "description": "Open-Access QCA (Qualitative Comparative Analysis) — Neubau von Ragins fs/QCA als moderne, reproduzierbare Web- und Desktop-App.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "benchmark:performance": "node scripts/performance-benchmark.mjs",
    "test:engine": "npm test --workspace @openqca/engine",
    "check:reference": "node scripts/reference-check.mjs",
    "check:r": "node scripts/cross-validate.mjs",
    "check:r-calibration": "node scripts/calibrate-cross-validate.mjs",
    "check:engine-package": "node scripts/check-engine-package.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:research-protocol": "node --test scripts/aggregate-research-observations.test.mjs",
    "research:key": "node scripts/aggregate-research-observations.mjs --create-key",
    "research:template": "node scripts/aggregate-research-observations.mjs --template",
    "research:aggregate": "node scripts/aggregate-research-observations.mjs",
    "verify": "npm run test:engine && npm run check:reference && npm run check:r && npm run check:r-calibration && npm run check:engine-package && npm run check:deployment && npm run test:research-protocol && npm run lint --workspace web && npm run build --workspace web && npm run test:e2e --workspace web",
    "smoke:staging": "bash deploy/smoke-staging.sh",
    "release:staging": "bash deploy/staging-release.sh"
  },
  "license": "MIT"
}
